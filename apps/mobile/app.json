{
  "expo": {
    "name": "Fundo360",
    "slug": "fundo360",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "fundo360",
    "splash": {
      "backgroundColor": "#1b5e20",
      "resizeMode": "contain"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1b5e20"
      },
      "package": "com.fundo360.app"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fundo360.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Permitir acceso a la cámara para escanear badges QR"
        }
      ],
      "expo-splash-screen"
    ]
  }
}
