{
  "expo": {
    "name": "Fundo360",
    "slug": "fundo360",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "fundo360",
    "icon": "./assets/icon.png",
    "backgroundColor": "#1b5e20",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/0a909e0d-5555-4590-a113-ac838c92040f",
      "fallbackToCacheTimeout": 0
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1b5e20"
      },
      "package": "com.fundo360.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fundo360.app",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "La aplicación usa Bluetooth para leer el peso desde la balanza conectada."
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1b5e20",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Permitir acceso a la cámara para escanear badges QR",
          "recordAudioAndroidPermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "enableUserScriptSandboxing": false
          },
          "android": {
            "gradleProperties": {
              "org.gradle.jvmargs": "-Xmx4096m -XX:MaxMetaspaceSize=2048m -XX:+HeapDumpOnOutOfMemoryError"
            }
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0a909e0d-5555-4590-a113-ac838c92040f"
      }
    },
    "owner": "joscorne"
  }
}
